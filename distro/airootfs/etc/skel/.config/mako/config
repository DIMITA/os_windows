# WilOS Aurora — notification daemon
sort=-time
layer=overlay
anchor=top-right
margin=12,12,0,0
padding=14,18
border-size=1
border-radius=14
default-timeout=6000
ignore-timeout=1
font=Inter 11

background-color=#15151ECC
text-color=#ECEEF6
border-color=#FFFFFF1A
progress-color=over #7CC8FF66

on-notify=exec paplay --volume=24576 /usr/share/sounds/wilos/notification.oga

[urgency=high]
border-color=#FF8A8A
default-timeout=0
on-notify=exec paplay --volume=32768 /usr/share/sounds/wilos/error.oga

[urgency=low]
text-color=#ECEEF699
on-notify=none
