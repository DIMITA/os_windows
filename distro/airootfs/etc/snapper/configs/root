# WilOS Snapper config — Btrfs snapshot policy for the root subvolume.
SUBVOLUME="/"
FSTYPE="btrfs"

# Permissions
ALLOW_USERS=""
ALLOW_GROUPS="wheel"
SYNC_ACL="yes"

# Per-snapshot defaults
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="50"
NUMBER_LIMIT_IMPORTANT="10"

# Timeline cleanup (snapshots taken on a fixed cadence)
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="6"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="4"
TIMELINE_LIMIT_MONTHLY="6"
TIMELINE_LIMIT_YEARLY="0"

# Empty pre/post snapshot pairs (e.g. pacman wraps that changed nothing)
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
