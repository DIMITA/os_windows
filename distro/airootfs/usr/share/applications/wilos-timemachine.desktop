[Desktop Entry]
Type=Application
Name=Time Machine
GenericName=Snapshot browser
Comment=Browse and roll back WilOS Btrfs snapshots
Exec=wilos-timemachine
Icon=wilos-timemachine
Terminal=false
Categories=System;Utility;
