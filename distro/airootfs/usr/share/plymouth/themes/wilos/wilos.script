# WilOS Aurora — Plymouth boot splash script.
# Solid Aurora background colour + centered logo + a slow-pulsing
# breathing animation. The minimum required hooks are implemented so
# password prompts (LUKS, etc.) still work cleanly.

# --- background -------------------------------------------------------
Window.SetBackgroundTopColor(0.06, 0.04, 0.08);     # #0F0A14
Window.SetBackgroundBottomColor(0.10, 0.07, 0.16);  # #1A1428

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# --- logo -------------------------------------------------------------
logo_image  = Image("wilos-logo.png");
logo_sprite = Sprite(logo_image);
logo_w      = logo_image.GetWidth();
logo_h      = logo_image.GetHeight();
logo_sprite.SetX(screen_w / 2 - logo_w / 2);
logo_sprite.SetY(screen_h / 2 - logo_h / 2 - 24);
logo_sprite.SetOpacity(1.0);
logo_sprite.SetZ(10);

# --- breathing pulse --------------------------------------------------
progress = 0.0;
fun refresh_callback() {
    progress += 0.02;
    pulse = 0.65 + 0.35 * Math.Cos(progress * 2.4);
    logo_sprite.SetOpacity(pulse);
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- password prompts (e.g. LUKS unlock) ------------------------------
status     = "normal";
prompt_box = NULL;

fun display_password_callback(prompt, bullets) {
    if (prompt_box) prompt_box = NULL;
    text = prompt + "  " + StringTimes("●", bullets);
    prompt_box = Image.Text(text, 0.92, 0.93, 0.96, 1.0, "Inter 14");
    sprite = Sprite(prompt_box);
    sprite.SetX(screen_w / 2 - prompt_box.GetWidth() / 2);
    sprite.SetY(screen_h / 2 + logo_h / 2 + 32);
    sprite.SetZ(20);
}

fun display_normal_callback() {
    if (prompt_box) prompt_box = NULL;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- shutdown / boot finished -----------------------------------------
fun quit_callback() {
    logo_sprite.SetOpacity(0.0);
}
Plymouth.SetQuitFunction(quit_callback);
