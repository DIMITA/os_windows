#!/usr/bin/env bash
# wilos-firstrun — runs once on the first interactive login.
# Applies user-level Aurora defaults (icon theme, cursor, fonts) via
# gsettings, then shows the welcome notification.
set -eu

mark="$HOME/.config/wilos-firstrun-done"
[[ -f "$mark" ]] && exit 0

apply_gsettings() {
    command -v gsettings >/dev/null || return 0
    local I="org.gnome.desktop.interface"
    gsettings set "$I" color-scheme           prefer-dark
    gsettings set "$I" gtk-theme              Adwaita-dark
    gsettings set "$I" icon-theme             wilos-aurora
    gsettings set "$I" cursor-theme           Adwaita
    gsettings set "$I" cursor-size            24
    gsettings set "$I" font-name              "Inter 11"
    gsettings set "$I" document-font-name     "Inter 11"
    gsettings set "$I" monospace-font-name    "JetBrainsMono Nerd Font 11"
    gsettings set "$I" enable-animations      true
    gsettings set "$I" font-antialiasing      grayscale
    gsettings set "$I" font-hinting           slight
    gsettings set "$I" clock-format           24h
    gsettings set "$I" show-battery-percentage true
    # macOS-leaning window controls: traffic lights on the LEFT.
    gsettings set "$I" gtk-decoration-layout  "close,minimize,maximize:"
}

apply_gsettings

# Wait for the compositor to settle, then launch the tour.
for _ in $(seq 1 20); do
    pgrep -x Hyprland >/dev/null && break
    sleep 0.5
done

if command -v wilos-tour >/dev/null; then
    wilos-tour &
elif command -v notify-send >/dev/null; then
    notify-send -i wilos -u normal "Welcome to WilOS Aurora" \
        "Press Super + Space to launch apps."
fi

# Login chime — soft Aurora arpeggio.
if [[ -r /usr/share/sounds/wilos/login.oga ]] && command -v paplay >/dev/null; then
    paplay --volume=32768 /usr/share/sounds/wilos/login.oga 2>/dev/null &
fi

mkdir -p "$(dirname "$mark")"
touch "$mark"
