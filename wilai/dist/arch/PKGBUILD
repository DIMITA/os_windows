# Maintainer: WilOS Aurora <maintainer@wilos.example>
pkgname=wilai
pkgver=0.9.0
pkgrel=1
pkgdesc="Wilai system agent for WilOS (Aurora desktop + Core headless): typed-tool LLM driver with hash-chained audit"
arch=('x86_64')
url='https://github.com/dimita/os_windows'
license=('MIT' 'Apache')
depends=('gcc-libs' 'glibc')
optdepends=(
    'ollama: local LLM runtime (default provider)'
    'whisper.cpp: speech-to-text engine for wilai-voice'
    'piper-tts: text-to-speech engine for wilai-voice'
    'alsa-utils: arecord/aplay used by wilai-voice'
    'libnotify: notify-send used by wilai-overlay'
    'zenity: prompt/confirm dialogs used by wilai-overlay'
    'nmap: pentest tool driven by tools/pentest/nmap.scan.yaml'
    'nuclei: pentest tool driven by tools/pentest/nuclei.run.yaml'
    'whatweb: pentest tool driven by tools/pentest/whatweb.scan.yaml'
    'openssh: ssh client used by remote.wilai.* federation tools'
    'socat: unix-socket bridge used by remote.wilai.* federation tools'
    'python: json encoder used by scripts/wilai-remote'
)
makedepends=('rust' 'cargo')
source=()
sha256sums=()

# Built from the in-tree workspace at $startdir/../..
# In a real release this PKGBUILD would point at a tagged tarball; for the
# WilOS ISO build it's invoked with $srcdir already prepared.

build() {
    cd "$startdir/../.."
    cargo build --release --frozen
}

package() {
    cd "$startdir/../.."
    install -Dm755 target/release/wilai          "$pkgdir/usr/bin/wilai"
    install -Dm755 target/release/wilai-daemon   "$pkgdir/usr/bin/wilai-daemon"
    install -Dm755 target/release/wilai-shell    "$pkgdir/usr/bin/wilai-shell"
    install -Dm755 target/release/wilai-voice    "$pkgdir/usr/bin/wilai-voice"
    install -Dm755 target/release/wilai-overlay  "$pkgdir/usr/bin/wilai-overlay"
    install -Dm755 target/release/wilai-hud      "$pkgdir/usr/bin/wilai-hud"
    # Installer helper (bash) — called by sys.install.* YAML tools.
    install -Dm755 scripts/wilai-install         "$pkgdir/usr/bin/wilai-install"
    # Self-update helper — called by sys.wilai.update.
    install -Dm755 scripts/wilai-selfupdate      "$pkgdir/usr/bin/wilai-selfupdate"
    # Federation helper — called by remote.wilai.* YAML tools.
    install -Dm755 scripts/wilai-remote          "$pkgdir/usr/bin/wilai-remote"
    # Assets: the robot face used by the HUD overlay.
    install -Dm644 assets/wilai-face.png         "$pkgdir/usr/share/wilai/assets/wilai-face.png"

    # Ship the entire tools/ tree (core/ + pentest/ subdirs).
    install -d "$pkgdir/usr/share/wilai/tools/core"
    install -d "$pkgdir/usr/share/wilai/tools/pentest"
    install -Dm644 tools/core/*.yaml    "$pkgdir/usr/share/wilai/tools/core/"
    install -Dm644 tools/pentest/*.yaml "$pkgdir/usr/share/wilai/tools/pentest/"

    # Example config and systemd user unit.
    install -Dm644 config/wilai.toml.example \
        "$pkgdir/usr/share/wilai/wilai.toml.example"
    install -Dm644 dist/hyprland/wilai-hud.conf \
        "$pkgdir/usr/share/wilai/hyprland/wilai-hud.conf"
    install -Dm644 dist/mcp-examples.toml \
        "$pkgdir/usr/share/wilai/mcp-examples.toml"
    install -Dm644 dist/systemd/wilai.service \
        "$pkgdir/usr/lib/systemd/user/wilai.service"
    install -Dm644 dist/systemd/wilai-hud.service \
        "$pkgdir/usr/lib/systemd/user/wilai-hud.service"

    # WilOS-Core system units (installed, enabled by the ISO profile).
    install -Dm644 dist/arch/releng-core/airootfs/etc/systemd/system/wilai-daemon.service \
        "$pkgdir/usr/lib/systemd/system/wilai-daemon.service"
    install -Dm644 dist/arch/releng-core/airootfs/etc/systemd/system/wilai-shell.service \
        "$pkgdir/usr/lib/systemd/system/wilai-shell.service"

    # Docs.
    install -Dm644 README.md           "$pkgdir/usr/share/doc/wilai/README.md"
    install -Dm644 docs/architecture.md "$pkgdir/usr/share/doc/wilai/architecture.md"
    install -Dm644 docs/tool-format.md  "$pkgdir/usr/share/doc/wilai/tool-format.md"
    install -Dm644 docs/audit-format.md "$pkgdir/usr/share/doc/wilai/audit-format.md"
}
