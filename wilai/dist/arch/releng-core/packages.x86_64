# WilOS-Core package set. Strictly server-grade: NO X, NO Wayland,
# NO compositor. Wilai is the interface.

# Base
base
base-devel
linux
linux-firmware
intel-ucode
amd-ucode

# Boot / live-media essentials (also used by the on-disk installer that
# Wilai drives via sys.disk.* and sys.install.*).
arch-install-scripts
syslinux
grub
efibootmgr
dosfstools
btrfs-progs
e2fsprogs
xfsprogs
f2fs-tools
mtools
squashfs-tools
edk2-shell
# provides sgdisk
gptfdisk
parted

# Networking
networkmanager
iwd
wpa_supplicant
openssh
dhcpcd
openresolv
mobile-broadband-provider-info
modemmanager

# Audio stack (Wilai voice I/O)
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils

# Shell / term essentials
bash
bash-completion
sudo
less
vim
nano
tmux
htop
tree
curl
wget
rsync
git

# Hardware helpers
usbutils
pciutils
smartmontools
lshw
lm_sensors

# Virtualization / container helpers (optional on live)
qemu-guest-agent

# Local LLM runtime
ollama

# Voice stack: whisper.cpp (STT) + piper-tts (TTS) are AUR-only, so they
# cannot ship in the ISO's base package set — mkarchiso only pulls from
# official Arch repos. The first-boot wizard offers to fetch them via
# an AUR helper (yay/paru) once the system has network. User still has
# to drop a whisper model + a piper voice under /var/lib/wilai/models/
# before [voice] enabled = true actually produces sound. The shell
# probes and reports what's missing on launch.
# alsa-utils is already included above.

# Vision stack: grim/scrot for screen capture. The llava model is
# pulled lazily by `ollama pull llava:7b` when the user first asks
# vision.describe to run (keeps the ISO small).
grim
scrot

# Wilai itself (installed from the in-tree PKGBUILD at build time;
# see customize_airootfs.sh).
# wilai
