# WilOS-Core package set. Strictly server-grade: NO X, NO Wayland,
# NO compositor. Wilai is the interface.

# Base
base
base-devel
linux
linux-firmware
intel-ucode
amd-ucode

# Boot / live-media essentials (also used by the on-disk installer that
# Wilai drives via sys.disk.* and sys.install.*).
arch-install-scripts
syslinux
grub
efibootmgr
dosfstools
btrfs-progs
e2fsprogs
xfsprogs
f2fs-tools
mtools
squashfs-tools
edk2-shell
gptfdisk       # provides sgdisk
parted

# Networking
networkmanager
iwd
wpa_supplicant
openssh
dhcpcd
openresolv
mobile-broadband-provider-info
modemmanager

# Audio stack (Wilai voice I/O)
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils

# Shell / term essentials
bash
bash-completion
sudo
less
vim
nano
tmux
htop
tree
curl
wget
rsync
git

# Hardware helpers
usbutils
pciutils
smartmontools
lshw
lm_sensors

# Virtualization / container helpers (optional on live)
qemu-guest-agent

# Local LLM runtime
ollama

# Voice stack: whisper.cpp + piper + alsa-utils. Ship them so the shell
# can speak and listen out of the box; the user still has to drop a
# whisper model + a piper voice under /var/lib/wilai/models/ for them
# to actually run. The shell probes and reports what's missing.
whisper.cpp
piper
# alsa-utils already included above

# Wilai itself (installed from the in-tree PKGBUILD at build time;
# see customize_airootfs.sh).
# wilai
