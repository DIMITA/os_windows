#!/usr/bin/env bash
# wilai-vision — send an image + a question to the local Ollama server
# and print the model's answer. Called by vision.describe.
#
# Usage: wilai-vision <model> <image-path> <question...>

set -euo pipefail

model="${1:-llava:7b}"
image="${2:-}"
shift 2 || true
question="$*"

if [[ -z "$image" ]]; then
    echo "wilai-vision: missing image path" >&2
    exit 2
fi
if [[ ! -r "$image" ]]; then
    echo "wilai-vision: cannot read $image" >&2
    exit 2
fi
if ! command -v curl >/dev/null 2>&1; then
    echo "wilai-vision: curl not found" >&2
    exit 2
fi
if ! command -v base64 >/dev/null 2>&1; then
    echo "wilai-vision: base64 not found" >&2
    exit 2
fi

# Base64-encode the image for Ollama's /api/generate.
b64=$(base64 -w0 "$image" 2>/dev/null || base64 "$image" | tr -d '\n')

payload=$(python3 - "$model" "$question" "$b64" <<'PY'
import json, sys
model, prompt, b64 = sys.argv[1], sys.argv[2], sys.argv[3]
print(json.dumps({
    "model": model,
    "prompt": prompt or "Describe this image.",
    "stream": False,
    "images": [b64],
}))
PY
) || {
    echo "wilai-vision: python3 required to encode the request" >&2
    exit 2
}

# Call the LOCAL Ollama endpoint only. Never a remote URL — vision
# describes screenshots which may contain anything.
resp=$(curl -s --max-time 115 \
    -H 'content-type: application/json' \
    --data-binary "$payload" \
    http://127.0.0.1:11434/api/generate) || {
    echo "wilai-vision: ollama call failed" >&2
    exit 1
}

echo "$resp" | python3 -c '
import json, sys
try:
    j = json.loads(sys.stdin.read())
except Exception as e:
    print(f"wilai-vision: bad response: {e}", file=sys.stderr); sys.exit(1)
if "error" in j:
    print(f"wilai-vision: {j[\"error\"]}", file=sys.stderr); sys.exit(1)
print(j.get("response", "").strip())
'
