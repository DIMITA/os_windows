[general]
default_provider  = "ollama"
default_model     = "mistral:7b-instruct"
confirm_timeout_s = 30

[providers.ollama]
type  = "ollama"
url   = "http://127.0.0.1:11434"
local = true

[providers.claude]
type        = "anthropic"
api_key_env = "ANTHROPIC_API_KEY"
local       = false

[tools]
extra_dirs = []
disabled   = []

[audit]
chattr_append         = true
include_output_sample = true
max_size_mb           = 256

[mode]
auto_detect = true
threshold   = 100

[security]
# Hard-lock to local-only models. When true, non-local providers
# (anything with local = false) are refused in Normal mode too.
local_only = true

[persona]
# How Wilai addresses the user, which voice-model name to use, how
# proactive it may be (watchers, nudges).
address        = "Monsieur"
style          = "concise_butler"
voice_model    = "en_GB-alan-medium"
quota_per_hour = 3
proactivity    = "medium"

[memory]
# Keep the local SQLite memory disciplined. A daily task applies three
# cuts in order: TTL (drop notes older than ttl_days), max rows, soft
# byte budget. Then VACUUM reclaims disk. Zero disables a cut.
compact_enabled = true
ttl_days        = 180
max_notes       = 10000
max_bytes       = 134217728   # 128 MiB
compact_every_h = 24

[proactivity]
# When enabled, the daemon runs lightweight background watchers and
# sends ServerEvent::Nudge to connected clients when something crosses
# a threshold (a service fails, a disk fills up, a watched process
# disappears). The quota caps the firehose: ≤N nudges per rolling hour.
enabled           = false
quota_per_hour    = 6
systemd_poll_s    = 30
disk_poll_s       = 60
disk_threshold_pct = 10
watch_mounts      = ["/"]
watch_processes   = []
process_poll_s    = 30

[remotes]
# Federation: named SSH endpoints that run their own wilai-daemon.
# `remote.wilai.exec` and `remote.wilai.read` tools target these by
# name. Each remote has its own audit log and its own confirms — this
# is federation, not control. SSH authentication reuses the user's
# ~/.ssh/config and keys.
#
# [remotes.homelab]
# ssh         = "nora@homelab.lan"
# description = "The Arch box in the office"
# socket      = "/run/wilai.sock"
# allow_in_pentest = false
#
# [remotes.vps]
# ssh         = "root@vps.example.com"
# description = "Scaleway VPS"
# socket      = "/run/wilai.sock"

[voice]
# Local voice I/O for wilai-shell. All engines are subprocesses so this
# section is a no-op if they aren't installed. Set enabled = true (or
# pass --voice on the CLI) to boot the shell with voice I/O ready.
enabled       = false
whisper_bin   = "whisper-cli"
whisper_model = "ggml-base.en.bin"
piper_bin     = "piper"
# Leave piper_model empty to fall back to persona.voice_model + ".onnx".
piper_model   = ""
record_bin    = "arecord"
play_bin      = "aplay"
sample_rate   = 16000
record_secs   = 6
# Optional wake-word command. Each stdout line triggers a recording.
# Example (openWakeWord):
#   wake_cmd = "openwakeword --model /var/lib/wilai/models/hey_wil.onnx --emit-on-detect"
wake_cmd      = ""
tts_min_chars = 1

# Model Context Protocol servers. Each entry spawns a long-running
# subprocess at daemon startup and exposes its tools in the Wilai
# registry under `mcp.<server>.<tool>`. Disable any of them by setting
# `enabled = false` or by removing the section.
#
# [mcp.github]
# command = "npx"
# args    = ["-y", "@modelcontextprotocol/server-github"]
# env     = { GITHUB_PERSONAL_ACCESS_TOKEN = "..." }
# gate_in_pentest = true
#
# [mcp.brave]
# command = "brave-mcp-server"
# args    = []
# env     = { BRAVE_API_KEY = "..." }
